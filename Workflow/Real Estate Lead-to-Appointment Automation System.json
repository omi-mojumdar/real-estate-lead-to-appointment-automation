    {
      "parameters": {
        "jsCode": "const fields = $input.first().json.body.data.fields;\n\n// Helper: get text value by label\nconst get = (label) => {\n  const f = fields.find(f => f.label === label);\n  if (!f) return '';\n  \n  // Dropdown: value is an ID → look up text from options\n  if (f.type === 'DROPDOWN' || f.type === 'MULTIPLE_CHOICE' || f.type === 'CHECKBOXES') {\n    if (!f.value || f.value.length === 0) return '';\n    const selectedId = Array.isArray(f.value) ? f.value[0] : f.value;\n    const option = f.options.find(o => o.id === selectedId);\n    return option ? option.text : selectedId;\n  }\n  \n  return f.value || '';\n};\n\nconst email     = get('Email');\nconst firstName = get('First Name');\n\nif (!email)     throw new Error('Missing email');\nif (!firstName) throw new Error('Missing first name');\n\nreturn [{\n  json: {\n    firstName:  firstName,\n    lastName:   get('Last Name'),\n    email:      email,\n    phone:      get('Phone Number'),\n    intentRaw:  get('I want to...'),\n    budgetRaw:  get('Budget range'),\n    area:       get('Area of Interest')\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
