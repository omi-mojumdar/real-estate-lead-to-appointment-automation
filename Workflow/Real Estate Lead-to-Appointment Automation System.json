              "content": "=You are a real estate lead classifier.\n\nA lead just submitted this form data:\n{{ JSON.stringify($input.first().json) }}\n\nExtract and return ONLY this JSON:\n{\n  \"firstName\": \"\",\n  \"lastName\": \"\",\n  \"email\": \"\",\n  \"phone\": \"\",\n  \"leadType\": \"buyer or seller or renter\",\n  \"budget\": \"\",\n  \"area\": \"\"\n}"
            }
