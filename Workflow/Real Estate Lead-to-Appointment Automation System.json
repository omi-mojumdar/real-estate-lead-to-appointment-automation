      "parameters": {
        "jsCode": "const rawText = $input.first().json.content.parts[0].text;\n\n// Clean markdown fences if any\nconst cleaned = rawText\n  .replace(/```json\\n?/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nconst ai = JSON.parse(cleaned);\n\nreturn [{\n  json: {\n    firstName:  ai.firstName,\n    lastName:   ai.lastName,\n    email:      ai.email,\n    phone:      ai.phone,\n    leadType:   ai.leadType,   // \"buyer\" / \"seller\" / \"renter\"\n    budget:     ai.budget,\n    area:       ai.area\n  }\n}];"
